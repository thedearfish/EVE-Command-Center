<Window x:Class="EveCommandCenter.Presentation.FloatingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EveCommandCenter.Presentation"
        xmlns:preview="clr-namespace:EveCommandCenter.Windows.Preview;assembly=EveCommandCenter.Windows"
        local:PreviewGroupingBehavior.IsEnabled="True"
        Title="{Binding DisplayName}"
        Width="320"
        Height="210"
        MinWidth="120"
        MinHeight="48"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#0B1117"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI"
        PreviewMouseLeftButtonDown="OnSurfacePreviewMouseLeftButtonDown"
        PreviewMouseMove="OnSurfacePreviewMouseMove"
        PreviewMouseLeftButtonUp="OnSurfacePreviewMouseLeftButtonUp"
        LostMouseCapture="OnSurfaceLostMouseCapture">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DataTemplate x:Key="StandardPreviewTemplate">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="10,7"
                Background="#111A22"
                BorderThickness="0"
                Visibility="{Binding ShowHeader, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#55C2A2"
                       FontSize="12"
                       Text="● LIVE" />
            <StackPanel>
              <TextBlock FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding DisplayName}" />
              <TextBlock Margin="0,2,0,0"
                         Foreground="#AAB7C4"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding CustomLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CustomLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#05080C"
                BorderThickness="0"
                ClipToBounds="True">
          <Grid>
            <preview:DwmThumbnailHost SourceWindowId="{Binding SourceWindowId, Mode=OneWay}"
                                      ThumbnailOpacity="{Binding Opacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
            <TextBlock Margin="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#D96C75"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type preview:DwmThumbnailHost}}, Path=ErrorText}" />
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageOnlyPreviewTemplate">
      <Border Background="#05080C" BorderThickness="0" ClipToBounds="True">
        <Grid>
          <preview:DwmThumbnailHost SourceWindowId="{Binding SourceWindowId, Mode=OneWay}"
                                    ThumbnailOpacity="{Binding Opacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
          <TextBlock Margin="12"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="#D96C75"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type preview:DwmThumbnailHost}}, Path=ErrorText}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TextOnlyPreviewTemplate">
      <Border Padding="14,10"
              Background="#3A3F45"
              BorderThickness="0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding DisplayName}" />
          <TextBlock Margin="0,3,0,0"
                     HorizontalAlignment="Center"
                     Foreground="#D0D5DA"
                     FontSize="12"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding CustomLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CustomLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border Background="#0B1117" BorderThickness="0">
    <ContentControl Content="{Binding}">
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Setter Property="ContentTemplate" Value="{StaticResource StandardPreviewTemplate}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ContentMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="{x:Static local:PreviewContentMode.ImageOnly}">
              <Setter Property="ContentTemplate" Value="{StaticResource ImageOnlyPreviewTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ContentMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="{x:Static local:PreviewContentMode.TextOnly}">
              <Setter Property="ContentTemplate" Value="{StaticResource TextOnlyPreviewTemplate}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>
  </Border>
</Window>
