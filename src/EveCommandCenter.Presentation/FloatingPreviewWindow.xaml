<Window x:Class="EveCommandCenter.Presentation.FloatingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EveCommandCenter.Presentation"
        xmlns:preview="clr-namespace:EveCommandCenter.Windows.Preview;assembly=EveCommandCenter.Windows"
        local:PreviewGroupingBehavior.IsEnabled="True"
        Title="{Binding DisplayName}"
        Width="320"
        Height="210"
        MinWidth="120"
        MinHeight="48"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#05080C"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI"
        SourceInitialized="OnServiceWindowSourceInitialized"
        Loaded="OnPreviewWindowLoaded"
        LocationChanged="OnPreviewWindowLocationChanged"
        IsVisibleChanged="OnPreviewWindowVisibilityChanged"
        StateChanged="OnPreviewWindowStateChanged"
        PreviewMouseLeftButtonDown="OnSurfacePreviewMouseLeftButtonDown"
        PreviewMouseMove="OnSurfacePreviewMouseMove"
        PreviewMouseLeftButtonUp="OnSurfacePreviewMouseLeftButtonUp"
        LostMouseCapture="OnSurfaceLostMouseCapture">
  <Window.Resources>
    <DataTemplate x:Key="StandardPreviewTemplate">
      <Grid Background="#05080C" ClipToBounds="True">
        <preview:DwmThumbnailHost SourceWindowId="{Binding SourceWindowId, Mode=OneWay}"
                                  ThumbnailOpacity="{Binding PreviewOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingPreviewWindow}}}" />
        <TextBlock Margin="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#FFB5B5"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type preview:DwmThumbnailHost}}, Path=ErrorText}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageOnlyPreviewTemplate">
      <Grid Background="#05080C" ClipToBounds="True">
        <preview:DwmThumbnailHost SourceWindowId="{Binding SourceWindowId, Mode=OneWay}"
                                  ThumbnailOpacity="{Binding PreviewOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingPreviewWindow}}}" />
        <TextBlock Margin="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#FFB5B5"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type preview:DwmThumbnailHost}}, Path=ErrorText}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TextOnlyPreviewTemplate">
      <Border Padding="14,10"
              Background="#3A3F45"
              BorderThickness="0"
              Opacity="{Binding PreviewOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingPreviewWindow}}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center"
                     Foreground="#FFD34A"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding DisplayName}" />
          <TextBlock Margin="0,2,0,0"
                     HorizontalAlignment="Center"
                     Foreground="#D9EEFF"
                     FontSize="12"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding CurrentSystem}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentSystem}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Margin="0,2,0,0"
                     HorizontalAlignment="Center"
                     Foreground="#F2F6FA"
                     FontSize="12"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding CustomLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CustomLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border Background="#05080C" BorderThickness="0" SnapsToDevicePixels="True">
    <ContentControl Content="{Binding}">
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Setter Property="ContentTemplate" Value="{StaticResource StandardPreviewTemplate}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ContentMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="{x:Static local:PreviewContentMode.ImageOnly}">
              <Setter Property="ContentTemplate" Value="{StaticResource ImageOnlyPreviewTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ContentMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="{x:Static local:PreviewContentMode.TextOnly}">
              <Setter Property="ContentTemplate" Value="{StaticResource TextOnlyPreviewTemplate}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>
  </Border>
</Window>
