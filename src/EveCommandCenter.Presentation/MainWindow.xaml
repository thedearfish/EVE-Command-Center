<Window x:Class="EveCommandCenter.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0E141B"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="#8B9AAA"
                 FontSize="14"
                 Text="Live EVE client discovery diagnostics" />
    </StackPanel>

    <UniformGrid Grid.Row="2" Columns="4">
      <Border Margin="0,0,10,0" Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="EVE CLIENTS" />
          <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding ClientCount}" />
        </StackPanel>
      </Border>
      <Border Margin="0,0,10,0" Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="READY" />
          <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding CharacterCount}" />
        </StackPanel>
      </Border>
      <Border Margin="0,0,10,0" Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="CHARACTER SELECT" />
          <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding CharacterSelectionCount}" />
        </StackPanel>
      </Border>
      <Border Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="LAST SCAN" />
          <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding LastScanText}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Grid.Row="4"
            Padding="18"
            Background="#151E27"
            BorderBrush="#263544"
            BorderThickness="1"
            CornerRadius="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="14" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
          <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Detected clients" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#8B9AAA"
                       Text="The list refreshes automatically every 750 ms." />
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="#8B9AAA"
                     FontSize="18"
                     Text="No EVE clients detected. Start EVE Online and keep this window open.">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ClientCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Clients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,10"
                          Padding="14"
                          Background="#101820"
                          BorderBrush="#2C3B4A"
                          BorderThickness="1"
                          CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,4,0,0" Foreground="#8B9AAA" Text="{Binding WindowTitle}" />
                      </StackPanel>

                      <StackPanel Grid.Column="1">
                        <TextBlock Foreground="#8B9AAA" Text="STATE" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding State}" />
                      </StackPanel>

                      <StackPanel Grid.Column="2">
                        <TextBlock Foreground="#8B9AAA" Text="PID" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ProcessId}" />
                      </StackPanel>

                      <StackPanel Grid.Column="3">
                        <TextBlock Foreground="#8B9AAA" Text="WINDOW" />
                        <TextBlock Margin="0,4,0,0" FontFamily="Consolas" Text="{Binding WindowId}" />
                      </StackPanel>

                      <StackPanel Grid.Column="4">
                        <TextBlock Foreground="#8B9AAA" Text="DIAGNOSTICS" />
                        <TextBlock Margin="0,4,0,0">
                          <Run Text="Visible: " /><Run Text="{Binding IsVisible}" />
                          <Run Text=" · Minimized: " /><Run Text="{Binding IsMinimized}" />
                          <Run Text=" · Responsive: " /><Run Text="{Binding IsResponsive}" />
                          <Run Text=" · Cycle: " /><Run Text="{Binding IsCycleEligible}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="6"
            Padding="12,8"
            Background="#111A22"
            BorderBrush="#263544"
            BorderThickness="1"
            CornerRadius="8">
      <TextBlock Foreground="#8B9AAA" Text="{Binding StatusMessage}" />
    </Border>
  </Grid>
</Window>
