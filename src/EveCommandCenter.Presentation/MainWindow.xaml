<Window x:Class="EveCommandCenter.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:EveCommandCenter.Windows.Preview;assembly=EveCommandCenter.Windows"
        Title="{Binding Title}"
        Width="1240"
        Height="820"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#0E141B"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="#8B9AAA"
                 FontSize="14"
                 Text="Live EVE client previews powered by Desktop Window Manager" />
    </StackPanel>

    <UniformGrid Grid.Row="2" Columns="4">
      <Border Margin="0,0,10,0" Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="EVE CLIENTS" />
          <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding ClientCount}" />
        </StackPanel>
      </Border>
      <Border Margin="0,0,10,0" Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="LIVE PREVIEWS" />
          <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding CharacterCount}" />
        </StackPanel>
      </Border>
      <Border Margin="0,0,10,0" Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="CHARACTER SELECT" />
          <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding CharacterSelectionCount}" />
        </StackPanel>
      </Border>
      <Border Padding="14" Background="#151E27" CornerRadius="8">
        <StackPanel>
          <TextBlock Foreground="#8B9AAA" Text="LAST SCAN" />
          <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding LastScanText}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Grid.Row="4"
            Padding="18"
            Background="#151E27"
            BorderBrush="#263544"
            BorderThickness="1"
            CornerRadius="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="14" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="Client previews" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="#8B9AAA"
                     Text="Ready characters render live. Character Selection remains excluded." />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding PreviewClients}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="555"
                        Height="360"
                        Margin="0,0,12,12"
                        Padding="12"
                        Background="#101820"
                        BorderBrush="#2C3B4A"
                        BorderThickness="1"
                        CornerRadius="8">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="10" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                      <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,3,0,0" Foreground="#8B9AAA" Text="{Binding WindowTitle}" />
                      </StackPanel>
                      <TextBlock DockPanel.Dock="Right"
                                 HorizontalAlignment="Right"
                                 Foreground="#8B9AAA"
                                 FontFamily="Consolas"
                                 Text="{Binding WindowId}" />
                    </DockPanel>

                    <Border Grid.Row="2"
                            Background="#070B10"
                            BorderBrush="#263544"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                      <Grid>
                        <preview:DwmThumbnailHost SourceWindowId="{Binding SourceWindowId, Mode=OneWay}" />
                        <TextBlock Margin="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#D96C75"
                                   TextWrapping="Wrap"
                                   Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type preview:DwmThumbnailHost}}, Path=ErrorText}" />
                      </Grid>
                    </Border>

                    <TextBlock Grid.Row="4" Foreground="#8B9AAA">
                      <Run Text="PID: " /><Run Text="{Binding ProcessId, Mode=OneWay}" />
                      <Run Text=" · Visible: " /><Run Text="{Binding IsVisible, Mode=OneWay}" />
                      <Run Text=" · Minimized: " /><Run Text="{Binding IsMinimized, Mode=OneWay}" />
                      <Run Text=" · Responsive: " /><Run Text="{Binding IsResponsive, Mode=OneWay}" />
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="6"
            Padding="12,8"
            Background="#111A22"
            BorderBrush="#263544"
            BorderThickness="1"
            CornerRadius="8">
      <TextBlock Foreground="#8B9AAA" Text="{Binding StatusMessage}" />
    </Border>
  </Grid>
</Window>
