<Window x:Class="EveCommandCenter.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0E141B"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
      <RowDefinition Height="20" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{Binding Title}"
                 FontSize="30"
                 FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="#8B9AAA"
                 FontSize="14"
                 Text="Multibox preview and client switching for EVE Online" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Padding="16"
              Background="#151E27"
              BorderBrush="#263544"
              BorderThickness="1"
              CornerRadius="10">
        <StackPanel>
          <TextBlock Margin="4,0,0,12"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#8B9AAA"
                     Text="SECTIONS" />
          <ListBox Background="Transparent"
                   BorderThickness="0"
                   Foreground="#E6EDF3"
                   SelectedIndex="0">
            <ListBoxItem Padding="10,8">Clients</ListBoxItem>
            <ListBoxItem Padding="10,8">Preview</ListBoxItem>
            <ListBoxItem Padding="10,8">Cycle</ListBoxItem>
            <ListBoxItem Padding="10,8">General</ListBoxItem>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Grid.Column="2"
              Padding="24"
              Background="#151E27"
              BorderBrush="#263544"
              BorderThickness="1"
              CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Text="Clients" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#8B9AAA"
                       Text="Detected EVE clients will appear here." />
          </StackPanel>

          <Border Grid.Row="2"
                  Padding="28"
                  Background="#101820"
                  BorderBrush="#2C3B4A"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Text="No clients discovered yet" />
              <TextBlock Margin="0,8,0,0"
                         HorizontalAlignment="Center"
                         Foreground="#8B9AAA"
                         Text="Window discovery will be implemented in the next milestone." />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="4"
            Padding="12,8"
            Background="#111A22"
            BorderBrush="#263544"
            BorderThickness="1"
            CornerRadius="8">
      <TextBlock Foreground="#8B9AAA"
                 Text="{Binding StatusMessage}" />
    </Border>
  </Grid>
</Window>
